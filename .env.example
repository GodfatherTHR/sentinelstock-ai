# Public browser configuration only. Never put a Supabase service-role key here.
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side API runtime (services/api). Requests are made with the caller's JWT,
# so row level security applies to every read and write.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-side only; keep this in the API runtime's secret store.
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-side-only

# true only lets the API run without a session (local work without auth). Default false.
DEMO_MODE=false
