# Copy to .env on the host (chmod 600) and fill in. Never commit the filled file.

# Supabase project the API reads and writes through.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-side-only

# The API expects real sessions by default; only set true for local work without auth.
DEMO_MODE=false

# Attribution for connector rows (defaults to the demo org from supabase/seed.sql).
INGEST_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# AI enrichment in the connectors (optional).
OPENROUTER_API_KEY=

# Connector pacing.
CONNECTOR_POLL_SECONDS=3600
FAOSTAT_DATASET=FBS
