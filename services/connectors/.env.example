# Copy to .env, fill in, and never commit. Connectors also accept these as real env vars.
# Hosted Supabase (recommended: no database password needed, writes go through PostgREST).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-side-only

# Optional direct Postgres fallback used only when the two values above are unset.
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Attribution for ingested rows (defaults to the demo org created by supabase/seed.sql).
INGEST_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# AI enrichment (only the enrich step needs this).
OPENROUTER_API_KEY=replace-me

# Source tuning (defaults shown).
# FAOSTAT_DATASET=FBS
# OFF_PAGES_PER_CATEGORY=3
# USDA_MAX_PRODUCTS=20000
# SENTINEL_LOOKBACK_DAYS=90
# ENRICHMENT_MAX_PRODUCTS=200
